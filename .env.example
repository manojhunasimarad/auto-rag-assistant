# Copy this file to .env and fill in what you need.
# Nothing here is required to run the project in mock/offline mode.

# Which LLM backend rag_chain.py / agent.py should use: mock | openai | anthropic
LLM_BACKEND=mock

# Which embedding backend to use: sentence-transformers | tfidf
# tfidf needs no downloads/network and is what the test suite uses.
# sentence-transformers gives real semantic embeddings (downloads a small
# model the first time it runs) and is what you'd use for the live demo.
EMBEDDER_BACKEND=sentence-transformers

# Only needed if LLM_BACKEND=openai
OPENAI_API_KEY=

# Only needed if LLM_BACKEND=anthropic
ANTHROPIC_API_KEY=

# Model names (defaults are sane if left blank)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
